{
  "name": "unreal-llm-index",
  "version": "0.1.0",
  "description": "Builds a compact, Unreal Engine-aware index of a UE C++ project and serves it to local LLMs over MCP, so small-context models can navigate the codebase without reading whole files.",
  "license": "MIT",
  "author": "Siddartha Gonnabattula",
  "keywords": [
    "unreal-engine",
    "llm",
    "mcp",
    "ollama",
    "code-index"
  ],
  "bin": {
    "ue-llm-index": "dist/cli.js"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "node dist/agent-smoke.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  }
}
